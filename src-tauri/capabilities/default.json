{
  "identifier": "default",
  "description": "Default capabilities for the app",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-write",
    "fs:allow-read",
    "fs:allow-mkdir",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "content:*" }]
    },
    "path:default"
  ]
}
