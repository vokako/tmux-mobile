{
  "name": "tmux-mobile",
  "private": true,
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "node --test 'src/**/*.test.js' 'src/**/*.test.ts'",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/preflight.mjs dev && tauri dev",
    "tauri:dev:release": "node scripts/preflight.mjs dev && tauri dev --release",
    "tauri:build": "tauri build",
    "tauri:android": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "build:all": "npm run build && npm run tauri:build && npx tauri android build --target aarch64 --apk",
    "build:mac": "npm run tauri:build",
    "build:android": "npx tauri android build --target aarch64 --apk && node scripts/preflight.mjs android-apk",
    "predev": "node scripts/preflight.mjs dev"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "26.0.1",
    "svelte": "^5",
    "svelte-check": "4.7.3",
    "typescript": "5.9.3",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.33",
    "lucide-svelte": "^0.575.0",
    "marked": "^17.0.3",
    "mermaid": "^11.12.3",
    "pdfjs-dist": "^5.4.624"
  }
}
